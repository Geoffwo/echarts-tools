{"name": "echarts-tools",
  "version": "1.1.11",
  "description": "Simplified ECharts utilities for Vue2 and HTML",
  "main": "dist/cjs/index.js",
  "files": [
    "page",
    "dist",
    "README.md",
    "README-zh.md"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "peerDependencies": {
    "echarts": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Geoffwo/echarts-tools.git"
  },
  "homepage": "https://gitee.com/Geoffwo/echarts-tools#readme",
  "keywords": [
    "echarts",
    "vue2",
    "charts",
    "data-visualization"
  ],
  "scripts": {
    "build": "npm run es5build & npm run obfuscate",
    "es5build": "node ./config/esbuild.mjs",
    "obfuscate": "npm run obfuscate:iife & npm run obfuscate:cjs",
    "obfuscate:iife": "javascript-obfuscator ./dist/iife --output ./dist/iife --config ./config/obfuscator.config.js",
    "obfuscate:cjs": "javascript-obfuscator ./dist/cjs --output ./dist/cjs --config ./config/obfuscator.config.js",

    "registry:npm": "npm config set registry https://registry.npmjs.org/",
    "registry:mirror": "npm config set registry https://registry.npmmirror.com/",
    "login:npm": "npm login",
    "version:patch": "npm version patch",
    "publish:all": "npm publish",
    "unpublish:force": "npm unpublish echarts-tools@1.1.0-bate0.0.2 --force"
  },
  "author": "geoffwo",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.2",
    "javascript-obfuscator": "^4.1.1",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9"
  }
}
