{
  "name": "echarts-tools",
  "version": "1.1.5",
  "description": "Simplified ECharts utilities for Vue2",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README-zh.md"
  ],
  "peerDependencies": {
    "echarts": "^5.0.0",
    "vue": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Geoffwo/echarts-tools.git"
  },
  "homepage": "https://gitee.com/Geoffwo/echarts-tools#readme",
  "keywords": [
    "echarts",
    "vue2",
    "charts",
    "data-visualization"
  ],
  "scripts": {
    "build": "npm run es5build && npm run obfuscate",
    "es5build": "node ./config/esbuild.mjs",
    "obfuscate": "javascript-obfuscator ./dist --output ./dist --config ./config/obfuscator.config.js"
  },
  "author": "geoffwo",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.2",
    "javascript-obfuscator": "^4.1.1",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9"
  }
}
